# North Investments Explorer Configuration
# Frontend URL: https://explorer.northinvestments.co
# Backend API: https://explorer.northinvestments.co

# App configuration (localhost for dev, override in deployment)
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PORT=3000

# Blockchain parameters
NEXT_PUBLIC_NETWORK_NAME="North Investments Arbitrum Chain"
NEXT_PUBLIC_NETWORK_SHORT_NAME=NorthArb
NEXT_PUBLIC_NETWORK_ID=1
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Ether
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation

# API configuration
NEXT_PUBLIC_API_HOST=explorer.arbitrum.northinvestments.co
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_BASE_PATH=/

# UI configuration
NEXT_PUBLIC_NETWORK_LOGO=/static/NILogo.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=/static/NorthWh.png
NEXT_PUBLIC_NETWORK_ICON=/static/NILogo.png
NEXT_PUBLIC_NETWORK_ICON_DARK=/static/NorthWh.png
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# Disable ads
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# SVG sprite hash (generated by deploy/scripts/build_sprite.sh)
NEXT_PUBLIC_ICON_SPRITE_HASH=db73ce37

# App features
NEXT_PUBLIC_APP_ENV=development
